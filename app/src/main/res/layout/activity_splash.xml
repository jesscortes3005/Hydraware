<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/colorBackground">

    <ImageView
        android:id="@+id/splashLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@mipmap/ic_launcher_round"
        android:contentDescription="Logo" />

    <LinearLayout
        android:id="@+id/lettersContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/letter0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="H"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextSecondary" />

        <TextView
            android:id="@+id/letter1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Y"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginStart="2dp" />

        <TextView
            android:id="@+id/letter2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="D"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginStart="2dp" />

        <TextView
            android:id="@+id/letter3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginStart="2dp" />

        <TextView
            android:id="@+id/letter4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginStart="2dp" />

        <TextView
            android:id="@+id/letter5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="W"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginStart="2dp" />

        <TextView
            android:id="@+id/letter6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginStart="2dp" />

        <TextView
            android:id="@+id/letter7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginStart="2dp" />

        <TextView
            android:id="@+id/letter8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="E"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginStart="2dp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monitorea la calidad del agua"
        android:textSize="18sp"
        android:textColor="@color/colorTextSecondary"
        android:layout_marginTop="8dp" />
</LinearLayout> 